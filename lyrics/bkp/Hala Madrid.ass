Dialogue: 0,0:00:00.03,0:00:04.23,Default,,0,0,0,,Historia que tú hiciste\N♪ 史册烙下王的名章 ♪
Dialogue: 0,0:00:04.53,0:00:07.41,Default,,0,0,0,,Historia por hacer\N♪ 新篇待君续辉煌 ♪
Dialogue: 0,0:00:07.73,0:00:11.87,Default,,0,0,0,,Porque nadie resiste\N♪ 谁人可挡这锋芒 ♪
Dialogue: 0,0:00:12.16,0:00:15.66,Default,,0,0,0,,Tus ganas de vencer\N♪ 战魂燃尽为胜狂 ♪
Dialogue: 0,0:00:15.99,0:00:19.68,Default,,0,0,0,,Ya salen las estrellas\N♪ 银河倾泻伯纳乌穹苍 ♪
Dialogue: 0,0:00:19.68,0:00:23.89,Default,,0,0,0,,Mi viejo Chamartín\N♪ 故垒查马丁(伯纳乌前身)星光未央 ♪
Dialogue: 0,0:00:24.16,0:00:27.93,Default,,0,0,0,,De lejos y de cerca\N♪ 四海八荒 ♪
Dialogue: 0,0:00:27.93,0:00:31.39,Default,,0,0,0,,Nos traes hasta aquí\N♪ 朝圣之路终抵此 ♪
Dialogue: 0,0:00:31.99,0:00:35.47,Default,,0,0,0,,Llevo tu camiseta\N♪ 白袍浸骨成铠甲 ♪
Dialogue: 0,0:00:35.97,0:00:39.67,Default,,0,0,0,,Pegada al corazón\N♪ 十五冠心焰灼烫徽章 ♪
Dialogue: 0,0:00:40.22,0:00:43.61,Default,,0,0,0,,Los días que tú juegas\N♪ 你征尘漫卷时光 ♪
Dialogue: 0,0:00:43.96,0:00:47.29,Default,,0,0,0,,Son todo lo que soy\N♪ 即我生命全部重量 ♪
Dialogue: 0,0:00:47.74,0:00:51.52,Default,,0,0,0,,Ya corre La Saeta\N♪ 金箭(传奇球员迪斯蒂法诺)离弦裂长夜 ♪
Dialogue: 0,0:00:51.87,0:00:55.55,Default,,0,0,0,,Ya ataca mi Madrid\N♪ 银鞍白马破敌疆 ♪
Dialogue: 0,0:00:55.80,0:01:00.04,Default,,0,0,0,,Soy lucha, soy belleza\N♪ 我骁勇无双 我华美如诗 ♪
Dialogue: 0,0:01:00.04,0:01:03.77,Default,,0,0,0,,El grito que aprendí\N♪ 呐喊血脉喷张 ♪
Dialogue: 0,0:01:03.77,0:01:06.12,Default,,0,0,0,,Madrid\N马德里！
Dialogue: 0,0:01:06.39,0:01:07.82,Default,,0,0,0,,Madrid\N马德里！
