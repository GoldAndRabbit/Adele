Dialogue: 0,0:00:03.18,0:00:09.93,Default,,0,0,0,,«Pazza Inter»\N疯狂的国米
Dialogue: 0,0:00:16.76,0:00:20.54,Default,,0,0,0,,Lo sai, per un gol\N♪ 你知道，为了踢进一球 ♪
Dialogue: 0,0:00:20.54,0:00:24.05,Default,,0,0,0,,Io darei la vita… la mia vita\N♪ 我愿付出生命…我的全部生命 ♪
Dialogue: 0,0:00:24.05,0:00:27.60,Default,,0,0,0,,Che in fondo lo so\N♪ 因为我深知 ♪
Dialogue: 0,0:00:27.60,0:00:32.28,Default,,0,0,0,,Sarà una partita infinita\N♪ 这将是场永恒的竞赛 ♪
Dialogue: 0,0:00:39.06,0:00:42.76,Default,,0,0,0,,E un sogno che ho\N♪ 我有一个梦想 ♪
Dialogue: 0,0:00:42.76,0:00:46.45,Default,,0,0,0,,È un coro che sale a sognare\N♪ 那是逐梦而升的合唱 ♪
Dialogue: 0,0:00:46.45,0:00:50.04,Default,,0,0,0,,Su e giù dalla Nord\N♪ 在梅阿查北看台上下回荡 ♪
Dialogue: 0,0:00:50.04,0:00:54.53,Default,,0,0,0,,Novanta minuti per segnare!\N♪ 为进球战斗九十分钟！ ♪
Dialogue: 0,0:00:54.53,0:00:56.33,Default,,0,0,0,,Nerazzurri!\N♪ 蓝黑战士！ ♪
Dialogue: 0,0:00:56.73,0:00:58.66,Default,,0,0,0,,Noi saremo qui!\N♪ 我们永远在此！ ♪
Dialogue: 0,0:00:58.66,0:01:00.57,Default,,0,0,0,,Nerazzurri!\N♪ 蓝黑战士！ ♪
Dialogue: 0,0:01:00.57,0:01:02.03,Default,,0,0,0,,Pazzi come te!\N♪ 如你一般疯狂！ ♪
Dialogue: 0,0:01:02.03,0:01:04.25,Default,,0,0,0,,Nerazzurri!\N♪ 蓝黑战士！ ♪
Dialogue: 0,0:01:04.25,0:01:06.83,Default,,0,0,0,,Non fateci soffrire\N♪ 别让我们受苦 ♪
Dialogue: 0,0:01:06.83,0:01:09.91,Default,,0,0,0,,Ma va bene… vinceremo insieme!\N♪ 但没关系…我们将一起胜利！ ♪
Dialogue: 0,0:01:10.21,0:01:11.94,Default,,0,0,0,,Amala!\N♪ 爱上她吧！ ♪
Dialogue: 0,0:01:12.64,0:01:16.26,Default,,0,0,0,,Pazza Inter amala!\N♪ 爱上这疯狂的国米！ ♪
Dialogue: 0,0:01:16.26,0:01:18.25,Default,,0,0,0,,È una gioia infinita\N♪ 那是无尽的喜悦 ♪
Dialogue: 0,0:01:18.25,0:01:20.02,Default,,0,0,0,,Che dura una vita\N♪ 贯穿一生 ♪
Dialogue: 0,0:01:20.28,0:01:24.06,Default,,0,0,0,,Pazza Inter amala!\N♪ 爱上这疯狂的国米！ ♪
Dialogue: 0,0:01:24.89,0:01:26.42,Default,,0,0,0,,Vivila!\N♪ 来体验吧！ ♪
Dialogue: 0,0:01:27.62,0:01:31.15,Default,,0,0,0,,Questa storia vivila\N♪ 来体验这段传奇 ♪
Dialogue: 0,0:01:31.15,0:01:33.14,Default,,0,0,0,,Può durare una vita\N♪ 它可能持续一生 ♪
Dialogue: 0,0:01:33.14,0:01:35.12,Default,,0,0,0,,O una sola partita\N♪ 或仅是一场比赛 ♪
Dialogue: 0,0:01:35.12,0:01:39.90,Default,,0,0,0,,Pazza Inter amala!\N♪ 爱上这疯狂的国米！ ♪
Dialogue: 0,0:01:44.92,0:01:48.45,Default,,0,0,0,,E continuerò\N♪ 我将继续前行 ♪
Dialogue: 0,0:01:48.45,0:01:52.05,Default,,0,0,0,,Nel sole e nel vento la mia festa\N♪ 风雨骄阳中我的庆典 ♪
Dialogue: 0,0:01:52.05,0:01:56.00,Default,,0,0,0,,Per sempre vivrò\N♪ 我将永远铭记 ♪
Dialogue: 0,0:01:56.00,0:01:59.65,Default,,0,0,0,,Con questi colori nella testa\N♪ 这色彩铭刻于心 ♪
Dialogue: 0,0:02:00.15,0:02:02.24,Default,,0,0,0,,Nerazzurri!\N♪ 蓝黑战士！ ♪
Dialogue: 0,0:02:02.24,0:02:03.71,Default,,0,0,0,,Io vi seguirò\N♪ 我将追随你们 ♪
Dialogue: 0,0:02:03.71,0:02:05.96,Default,,0,0,0,,Nerazzurri!\N♪ 蓝黑战士！ ♪
Dialogue: 0,0:02:06.36,0:02:07.88,Default,,0,0,0,,Sempre lì vivrò\N♪ 永存于此 ♪
Dialogue: 0,0:02:07.88,0:02:09.25,Default,,0,0,0,,Nerazzurri!\N♪ 蓝黑战士！ ♪
Dialogue: 0,0:02:09.90,0:02:11.83,Default,,0,0,0,,Questa mia speranza\N♪ 若这希望消逝 ♪
Dialogue: 0,0:02:11.83,0:02:13.62,Default,,0,0,0,,E l’assenza\N♪ 不复存在 ♪
Dialogue: 0,0:02:13.62,0:02:15.80,Default,,0,0,0,,Io non vivo senza!!!\N♪ 我亦无法独活！！！ ♪
Dialogue: 0,0:02:15.80,0:02:17.68,Default,,0,0,0,,Amala!\N♪ 爱上她吧！ ♪
Dialogue: 0,0:02:18.04,0:02:21.62,Default,,0,0,0,,Pazza Inter amala!\N♪ 爱上这疯狂的国米！ ♪
Dialogue: 0,0:02:21.88,0:02:23.55,Default,,0,0,0,,È una gioia infinita\N♪ 那是无尽的喜悦 ♪
Dialogue: 0,0:02:23.55,0:02:25.79,Default,,0,0,0,,Che dura una vita\N♪ 贯穿一生 ♪
Dialogue: 0,0:02:25.79,0:02:29.25,Default,,0,0,0,,Pazza Inter amala!\N♪ 爱上这疯狂的国米！ ♪
Dialogue: 0,0:02:30.70,0:02:33.25,Default,,0,0,0,,Seguila!\N♪ 跟随她吧！ ♪
Dialogue: 0,0:02:33.25,0:02:36.94,Default,,0,0,0,,In trasferta o giù in città\N♪ 无论客场或米兰城 ♪
Dialogue: 0,0:02:36.94,0:02:39.07,Default,,0,0,0,,Può durare una vita\N♪ 可能持续一生 ♪
Dialogue: 0,0:02:39.07,0:02:40.86,Default,,0,0,0,,Una sola partita\N♪ 或仅一场比赛 ♪
Dialogue: 0,0:02:40.86,0:02:43.15,Default,,0,0,0,,Pazza Inter amala!\N♪ 爱上这疯狂的国米！ ♪
Dialogue: 0,0:02:43.15,0:02:46.25,Default,,0,0,0,,Là in mezzo al campo\N♪ 在那梅阿查球场中央 ♪
Dialogue: 0,0:02:46.25,0:02:47.05,Default,,0,0,0,,C’è un nuovo campione\N♪ 诞生新的冠军 ♪
Dialogue: 0,0:02:47.05,0:02:53.25,Default,,0,0,0,,Un tiro che parte da questa canzone\N♪ 这支歌激发的射门 ♪
Dialogue: 0,0:02:53.25,0:02:54.39,Default,,0,0,0,,Forza non mollare mai!!!\N♪ 永不放弃 全力拼搏！！！ ♪
Dialogue: 0,0:02:55.17,0:02:57.15,Default,,0,0,0,,AMALA!\N♪ 爱上她吧！♪
Dialogue: 0,0:03:09.95,0:03:11.50,Default,,0,0,0,,Amala!\N♪ 爱上她吧！♪
Dialogue: 0,0:03:12.71,0:03:15.25,Default,,0,0,0,,Pazza Inter amala!\N♪ 爱上这疯狂的国米！ ♪
Dialogue: 0,0:03:16.17,0:03:18.03,Default,,0,0,0,,Una gioia infinita\N♪ 无尽的喜悦 ♪
Dialogue: 0,0:03:18.03,0:03:20.02,Default,,0,0,0,,Che dura una vita\N♪ 贯穿一生 ♪
Dialogue: 0,0:03:20.03,0:03:24.02,Default,,0,0,0,,Pazza Inter amala!!!\N♪ 爱上这疯狂的国米！！！ ♪
Dialogue: 0,0:03:27.63,0:03:31.62,Default,,0,0,0,,Pazza Inter amala!!!\N♪ 爱上这疯狂的国米！！！ ♪
Dialogue: 0,0:03:34.38,0:03:36.38,Default,,0,0,0,,AMALA!\N♪ 爱上她吧！ ♪ ♪